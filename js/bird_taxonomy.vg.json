{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Taxonomic relationships among six familiar companion bird species.",
  "width": 1180,
  "height": 330,
  "padding": {
    "left": 12,
    "right": 12,
    "top": 8,
    "bottom": 8
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "#FFFFFF",
  "data": [
    {
      "name": "tree",
      "url": "data/bird_taxonomy.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [
            { "signal": "height - 64" },
            { "signal": "width - 130" }
          ],
          "as": ["y", "x", "depth", "children"]
        },
        {
          "type": "formula",
          "expr": "datum.y + 50",
          "as": "y"
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        { "type": "treelinks" },
        {
          "type": "linkpath",
          "orient": "horizontal",
          "shape": "diagonal",
          "sourceX": "source.x",
          "sourceY": "source.y",
          "targetX": "target.x",
          "targetY": "target.y"
        }
      ]
    },
    {
      "name": "headers",
      "values": [
        { "depth": 0, "label": "START" },
        { "depth": 1, "label": "GROUP" },
        { "depth": 2, "label": "FAMILY" },
        { "depth": 3, "label": "GENUS" },
        { "depth": 4, "label": "SPECIES" }
      ]
    }
  ],
  "scales": [
    {
      "name": "branchColour",
      "type": "ordinal",
      "domain": ["parrot", "songbird", "root"],
      "range": ["#398BA3", "#E96B73", "#A69B92"]
    }
  ],
  "marks": [
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": { "value": 0 },
          "x2": { "signal": "width" },
          "y": { "value": 40 },
          "stroke": { "value": "#EEE9E3" },
          "strokeWidth": { "value": 1 }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "headers" },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.depth * (width - 130) / 4"
          },
          "y": { "value": 20 },
          "text": { "field": "label" },
          "font": { "value": "Arial" },
          "fontSize": { "value": 11 },
          "fontWeight": { "value": "bold" },
          "fill": { "value": "#827773" },
          "letterSpacing": { "value": 0.7 },
          "baseline": { "value": "middle" }
        }
      }
    },
    {
      "type": "path",
      "from": { "data": "links" },
      "encode": {
        "update": {
          "path": { "field": "path" },
          "stroke": {
            "scale": "branchColour",
            "field": "target.group"
          },
          "strokeWidth": { "value": 1.9 },
          "strokeOpacity": { "value": 0.78 },
          "fill": { "value": null }
        }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "tree" },
      "encode": {
        "enter": {
          "size": { "value": 100 },
          "stroke": { "value": "#FFFFFF" },
          "strokeWidth": { "value": 1.5 }
        },
        "update": {
          "x": { "field": "x" },
          "y": { "field": "y" },
          "fill": {
            "scale": "branchColour",
            "field": "group"
          },
          "tooltip": {
            "signal": "{'Name': datum.label, 'Rank': datum.rank}"
          }
        },
        "hover": {
          "size": { "value": 145 }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "tree" },
      "encode": {
        "enter": {
          "font": { "value": "Arial" },
          "fontSize": { "value": 12 }
        },
        "update": {
          "x": { "field": "x" },
          "y": { "field": "y" },
          "text": { "field": "label" },
          "fill": {
            "signal": "datum.rank === 'Species' ? '#302D32' : '#6C6260'"
          },
          "fontWeight": {
            "signal": "datum.rank === 'Species' ? 'bold' : 'normal'"
          },
          "align": { "value": "left" },
          "baseline": {
            "signal": "datum.rank === 'Species' ? 'middle' : 'bottom'"
          },
          "dx": {
            "signal": "datum.rank === 'Species' ? 10 : -3"
          },
          "dy": {
            "signal": "datum.rank === 'Species' ? 0 : -12"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Arial"
  }
}
