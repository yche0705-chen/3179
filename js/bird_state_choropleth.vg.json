
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,

  "params": [
    {
      "name": "selectedSpecies",
      "value": "Budgerigar",
      "bind": {
        "input": "select",
        "options": ["Budgerigar", "Cockatiel"],
        "name": "Species: "
      }
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1EDE6",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/bird_state_counts.csv",
        "format": {
          "type": "csv",
          "parse": {
            "observation_count": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "datum.species === selectedSpecies"
        },
        {
          "calculate": "datum.state === 'New South Wales' ? 801150 : datum.state === 'Victoria' ? 227444 : datum.state === 'Queensland' ? 1729742 : datum.state === 'South Australia' ? 984321 : datum.state === 'Western Australia' ? 2527013 : datum.state === 'Tasmania' ? 68401 : datum.state === 'Northern Territory' ? 1347791 : datum.state === 'Australian Capital Territory' ? 2358 : null",
          "as": "area_km2"
        },
        {
          "calculate": "datum.observation_count / datum.area_km2 * 1000",
          "as": "observation_density"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/australia_states.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.state"
          },
          "as": "geo"
        }
      ],


      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      },

      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },

        "color": {
          "field": "observation_density",
          "type": "quantitative",
          "title": "Observations per 1,000 km²",
          "scale": {
            "type": "sqrt",
            "domain": [0, 45],
            "range": [
              "#E6F3F5",
              "#398BA3",
              "#14556B"
            ]
          },
          "legend": null
        },

        
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "observation_count",
            "type": "quantitative",
            "title": "Total observations",
            "format": ","
          },
          {
            "field": "observation_density",
            "type": "quantitative",
            "title": "Observations per 1,000 km²",
            "format": ".2f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
